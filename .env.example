# Database
DB_URL=jdbc:postgresql://localhost:5432/kanteelite
DB_USERNAME=kanteelite
DB_PASSWORD=kanteelite

# JWT
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_PENDING_EXPIRATION_MINUTES=30
PAYMENT_PENDING_CLEANUP_INTERVAL_MS=300000
# Comma-separated list of allowed browser origins for backend CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
